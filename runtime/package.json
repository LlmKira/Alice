{
  "name": "alice-runtime",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env --env-file-if-exists=../.env.local src/index.ts",
    "start:check": "tsx --env-file=.env --env-file-if-exists=../.env.local src/index.ts --check",
    "login": "tsx --env-file=.env --env-file-if-exists=../.env.local src/index.ts --login",
    "platform": "tsx src/sim/platform.ts",
    "northstar": "tsx src/northstar.ts",
    "trace": "tsx src/sim/trace.ts",
    "census": "tsx src/sim/census.ts",
    "addressed": "tsx src/sim/addressed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo",
    "lint": "biome check --write src/ test/ && eslint --fix .",
    "lint:check": "biome check src/ test/ && eslint --cache --cache-location .eslintcache .",
    "format": "biome format --write src/ test/",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "knip": "knip"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mtcute/dispatcher": "^0.32.8",
    "@mtcute/markdown-parser": "^0.32.8",
    "@mtcute/node": "^0.32.8",
    "better-sqlite3": "^11.0.0",
    "consola": "^3.4.2",
    "eld": "2.1.1",
    "ntgcalls": "3.0.7",
    "smol-toml": "^1.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@biomejs/biome": "^2.3.14",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vibe-proof": "^1.10.2",
    "knip": "^6.47.0",
    "vitest": "^3.0.0"
  }
}
